#====== ( Telegram ) ======#
# Gak perlu isi apapun di sini buat daftar bot.
# Bot otomatis ambil SEMUA row dari tabel telegram_bot_rentals di Supabase
# (yang status-nya bukan 'suspended'/'expired') dan jalanin semuanya.
# Tambah bot baru? Tinggal insert row baru di Supabase, lalu restart proses.
LOG_CHANNEL_ID=
BROADCAST_CHANNEL_ID=

#====== ( Supabase ) ======#
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Pakai service_role key (bukan anon) karena bot butuh baca/tulis semua rental
# tanpa RLS. JANGAN commit .env ini ke git, dan JANGAN taruh key ini di
# frontend/client manapun.
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_dari_supabase_settings_api

#====== ( Tripay ) ======#
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

#====== ( Pakasir ) ======#
PAKASIR_API_KEY=
PAKASIR_PROJECT=

#====== ( GoPay Merchant / QRIS statis — provider payment ke-2, opsional ) ======#
# Sama persis kayak yang dipakai fitur deposit di web (lib/qris.ts).
# Cuma wajib diisi kalau ada bot yang "Metode Pembayaran"-nya di-set ke
# GoPay Merchant lewat dashboard (Marketplace → bot → Metode Pembayaran).
QRIS_BASE_URL=https://fahri.otpcepet.site
QRIS_STATIC_CODE=
QRIS_OTP_TOKEN=
QRIS_API_KEY=freeApikey

#====== ( Order Kuota / QRIS ) ======#
QRIS_APIKEY=
QRIS_CODEQR=
QRIS_USERNAME=
AUTH_TOKEN=
MARCHATOK=

#====== ( Pterodactyl - Public ) ======#
PTERODACTYL_DOMAIN=
PTERODACTYL_API_KEY=
PTERODACTYL_EGG=15
PTERODACTYL_NEST_ID=5
PTERODACTYL_LOCATION=1

#====== ( Pterodactyl - Private ) ======#
PTERODACTYL_DOMAIN_PRIVATE=
PTERODACTYL_API_KEY_PRIVATE=
PTERODACTYL_EGG_PRIVATE=15
PTERODACTYL_NEST_ID_PRIVATE=5
PTERODACTYL_LOCATION_PRIVATE=1

#====== ( VPS Provider ) ======#
LINODE_API_TOKEN=
DIGITAL_OCEAN_API=

#====== ( Reseller Panel ) ======#
RESELLER_PRICE=1000
RESELLER_GROUP_ID=
RESELLER_GROUP_LINK=
